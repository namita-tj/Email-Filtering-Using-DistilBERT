# Copy to .env and fill in. Never commit .env.

# Where the trained model lives. If the folder is empty, it is downloaded from
# Azure Blob Storage (MODEL_BLOB_URL) or, if that is not set, from S3.
MODEL_DIR=spam_detection_model
# MODEL_BLOB_URL=https://<account>.blob.core.windows.net/models/spam_detection_model/
S3_BUCKET=spam-detection-model-storage
S3_PREFIX=spam_detection_model/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1

# Optional: override the confidence band from training (thresholds.json).
# LOW_THRESHOLD=0.3
# HIGH_THRESHOLD=0.8

# LLM fallback for uncertain emails: azure, openai or none.
# Left empty, it is picked from whichever credentials are set below.
LLM_PROVIDER=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO

# Azure Application Insights (traces, latency, prediction logs). Off when empty.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
